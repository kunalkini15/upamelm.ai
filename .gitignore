*.py[cod]
*$py.class
*.egg-info/
.eggs/
dist/
build/
*.egg

# Testing & Coverage
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# Build output
dist-ssr/
*.local

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Editor / OS
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Local env (never commit secrets; frontend and repo must not hold model credentials)
.env
.env.*
!.env.example

# Root-level playground only (anchored so module playgrounds keep their own rules)
/playground/
.playwright-cli/
ui/test-results/
ui/playwright-report/
ui/output/
ui/runs/

# Generated example outputs (keep curated sample_*.json fixtures tracked)
doc-intelligence/examples/cli_test_*.json

# Agentic study runs (per-document outputs; can be large)
muse-document-processing/runs/*/
!muse-document-processing/runs/.gitkeep

# Agentic ingestion runs (per-city outputs; can be large)
muse-source-ingestion/runs/*/
!muse-source-ingestion/runs/.gitkeep

# Local, human-curated agent lessons (machine/user specific)
/muse-source-ingestion/lessons/
/muse-document-processing/lessons/

# Agent playground (downloads, extraction scratch, intermediate artifacts)
muse-document-processing/playground/*/
!muse-document-processing/playground/.gitkeep

# Agent ingestion playground (search scratch, probes, failed downloads)
muse-source-ingestion/playground/*/
!muse-source-ingestion/playground/.gitkeep

runs/
pipeline-logs/
