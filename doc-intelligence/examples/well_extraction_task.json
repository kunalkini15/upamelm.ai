{
  "task_id": "monitoring_well_and_water_level_extraction",
  "objective": "Extract monitoring well basic inventory metadata and dated water-level observations",
  "instructions": "Extract well records from Annexure 1 and dated water level measurements from Annexure 2. Preserve verbatim well IDs, coordinates, depths in meters bgl, dates, and measurement values.",
  "fields": [
    "well_id",
    "village",
    "latitude",
    "longitude",
    "depth_mbgl",
    "aquifer_tapped"
  ],
  "output_schema": {
    "type": "object",
    "properties": {
      "well_id": {"type": "string"},
      "village": {"type": "string"},
      "latitude": {"type": "string"},
      "longitude": {"type": "string"},
      "depth_mbgl": {"type": "string"},
      "aquifer_tapped": {"type": "string"},
      "water_level_observations": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "date": {"type": "string"},
            "month": {"type": "string"},
            "year": {"type": "string"},
            "water_level_mbgl": {"type": "string"}
          }
        }
      }
    }
  },
  "coverage_scope": "sample",
  "max_relevant_pages": 4,
  "expand_annexures": true,
  "allow_escalation": true,
  "max_repair_attempts": 2
}
