{
  "name": "muse-adaptive-visualization",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Neutral global-map foundation for the adaptive scientific visualization module (bootstrap-default).",
  "scripts": {
    "dev": "vite --port 5200",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 5210",
    "test": "vitest run",
    "test:browser": "playwright test",
    "verify": "npm run build && npm run test && npm run test:browser"
  },
  "dependencies": {
    "maplibre-gl": "^5.0.0",
    "proj4": "^2.12.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.170.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.0",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^26.6.6",
    "@types/proj4": "^2.5.5",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@types/three": "^0.170.0",
    "@vitejs/plugin-react": "^4.3.0",
    "typescript": "^5.6.0",
    "vite": "^7.0.0",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  }
}
