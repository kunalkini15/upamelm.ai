# Copy this file to .env and fill in the two required API keys.
#
#   cp .env.example .env
#
# This default configuration uses Serper for Google web search and
# Meta Muse 1.3 Contributor for grounded candidate assessment.

# --- Search (required) -------------------------------------------------------
SOURCE_SEARCH_PROVIDER=serper
SERPER_API_KEY=replace-with-your-serper-api-key
SERPER_BASE_URL=https://google.serper.dev
SERPER_GL=in
SERPER_HL=en

# Optional fallback for difficult JavaScript pages; not used for primary search.
FIRECRAWL_API_KEY=
FIRECRAWL_BASE_URL=https://api.firecrawl.dev/v1

# --- Meta Muse 1.3 Contributor (required) -----------------------------------
MODEL_PROVIDER=meta
MODEL_API_KEY=replace-with-your-meta-api-key
MODEL_BASE_URL=https://api.meta.ai/v1
MODEL_NAME=muse-spark-1.3-contributor
MODEL_API_STYLE=responses

# --- Network and run limits (safe defaults; normally no changes needed) ------
SOURCE_HTTP_TIMEOUT_SECONDS=120
SOURCE_MAX_DOWNLOAD_MB=100
SOURCE_MAX_SEARCH_RESULTS=10
SOURCE_MAX_CANDIDATES_PER_CATEGORY=8
SOURCE_USER_AGENT=SubsurfaceSourceIntelligence/0.1 (+research)
